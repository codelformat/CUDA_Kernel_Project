# 机器 A：学校 GPU 服务器（共享），NVIDIA RTX PRO 6000 Blackwell Server Edition。LayerNorm 的全部数据来自这台机器。
# 用 `MACHINE=rtxpro6000` 选择。下面的值都可被同名环境变量覆盖。
MACHINE_ID="rtxpro6000: RTX PRO 6000 Blackwell Server (sm_120, 188 SM, 128 MB L2)"
GPU_MATCH="RTX PRO 6000"
REMOTE_HOST="${REMOTE_HOST:-4p6000}"
REMOTE_DIR="${REMOTE_DIR:-/home/guansheng/workspace/CUDA_Kernel_Project}"
CONDA_ENV="${CONDA_ENV:-omni}"
# 数据手册值：显存带宽 1597 GB/s，FP32 峰值 120 TFLOPS
PEAK_GBPS="${PEAK_GBPS:-1597}"
PEAK_TFLOPS="${PEAK_TFLOPS:-120}"

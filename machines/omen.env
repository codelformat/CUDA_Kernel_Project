# 机器 B：HP OMEN 17 笔记本（自己的机器，独占，sudo 免密，ncu 可用）。由 scripts/run.sh 按 GPU 型号自动选中。
# 用 `MACHINE=omen` 选择（remote.sh 默认）。下面的值都可被同名环境变量覆盖。
MACHINE_ID="omen: HP OMEN 17 + RTX 3080 Ti Laptop (sm_86, 58 SM, 4 MB L2)"
GPU_MATCH="3080 Ti"
REMOTE_HOST="${REMOTE_HOST:-omen}"
REMOTE_DIR="${REMOTE_DIR:-/home/harry/workspace/CUDA_Kernel_Project}"   # 在笔记本上: git clone 到这里（或改这一行）
CONDA_ENV="${CONDA_ENV:-cuda}"
# 理论峰值（仅供参考，实际持续时钟因笔记本功耗/温度会更低，主要指标看"相对 cuBLAS 的百分比"）
# PEAK_GBPS  : 256 bit × (nvidia-smi 显存时钟 8001 MHz × 2) / 8 ≈ 512 GB/s（按 GDDR6 双倍数据率推算）
# PEAK_TFLOPS: FP32 = 58 SM × 128 core × 2 × 最高 SM 时钟 2.1 GHz ≈ 31.2 TFLOPS
PEAK_GBPS="${PEAK_GBPS:-512}"
PEAK_TFLOPS="${PEAK_TFLOPS:-31.2}"
